{
  "name": "@deepseek-ai/dsh-official-services",
  "description": "Official account, Session upload, telemetry, feedback, and brand bundle for legacy public profiles",
  "version": "0.1.7-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/official-services"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-account-controller": "workspace:*",
    "@deepseek-ai/dsh-client-ui-brand-official": "workspace:*",
    "@deepseek-ai/dsh-client-ui-message-feedback": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings-account": "workspace:*",
    "@deepseek-ai/dsh-command-feedback": "workspace:*",
    "@deepseek-ai/dsh-deepseek-account-platform": "workspace:*",
    "@deepseek-ai/dsh-message-feedback": "workspace:*",
    "@deepseek-ai/dsh-session-log-deepseek": "workspace:*",
    "@deepseek-ai/dsh-session-telemetry-otel": "workspace:*"
  }
}
